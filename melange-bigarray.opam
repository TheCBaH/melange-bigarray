opam-version: "2.0"
synopsis: "Portable numerical arrays for Melange"
maintainer: "Vladimir Silyaev"
authors: "Vladimir Silyaev"
x-ai-disclosure: "ai-generated"
x-ai-provider: "Anthropic, OpenAI"
license: ["MIT" "LGPL-2.1-only WITH OCaml-LGPL-linking-exception"]
homepage: "https://github.com/TheCBaH/melange-bigarray"
bug-reports: "https://github.com/TheCBaH/melange-bigarray/issues"
dev-repo: "git+https://github.com/TheCBaH/melange-bigarray.git"
depends: [
  "ocaml" {(>= "4.14.4" & < "4.15") | (>= "5.2.1" & < "5.6")}
  "dune" {>= "3.21"}
  "melange" {>= "7.0.1" & < "8.0"}
  "conf-python-3" {build & >= "9.0.0"}
]
build: [ ["dune" "build" "-p" name "-j" jobs] ]
